#lang racket/base
(require "value.rkt" "update-manifest.rkt")
(provide encode-update-manifest decode-update-manifest)

;; An explicitly versioned canonical binary payload, not legacy JSON.
;; Neither decoding nor encoding establishes trust.
(define manifest-keys '("format" "application_id" "version" "build" "channel" "published_at" "minimum_version" "previous_version" "rollback_allowed" "rollout" "artifacts"))
(define artifact-keys '("platform" "architecture" "url" "sha256" "size" "installer" "arguments" "component" "signature"))
(define (closed-map! value keys)
  (unless (and (hash? value) (= (hash-count value) (length keys))
               (andmap (lambda (key) (hash-has-key? value key)) keys))
    (error 'decode-update-manifest "missing or unknown fields")))
(define (artifact->value a)
  (hash "platform" (update-artifact-platform a)
        "architecture" (update-artifact-architecture a)
        "url" (update-artifact-url a)
        "sha256" (update-artifact-sha256 a)
        "size" (update-artifact-size a)
        "installer" (update-artifact-installer a)
        "arguments" (update-artifact-arguments a)
        "component" (update-artifact-component a)
        "signature" (update-artifact-signature a)))
(define (manifest->value m)
  (hash "format" "keel-update-manifest/1"
        "application_id" (update-manifest-application-id m)
        "version" (update-manifest-version m)
        "build" (update-manifest-build m)
        "channel" (update-manifest-channel m)
        "published_at" (update-manifest-published-at m)
        "minimum_version" (update-manifest-minimum-version m)
        "previous_version" (update-manifest-previous-version m)
        "rollback_allowed" (update-manifest-rollback-allowed? m)
        "rollout" (update-manifest-rollout m)
        "artifacts" (map artifact->value (update-manifest-artifacts m))))
(define (value->artifact a)
  (closed-map! a artifact-keys)
  (update-artifact (hash-ref a "platform")
                   (hash-ref a "architecture")
                   (hash-ref a "url")
                   (hash-ref a "sha256")
                   (hash-ref a "size")
                   (hash-ref a "installer")
                   (hash-ref a "arguments")
                   (hash-ref a "component")
                   (hash-ref a "signature")))
(define (encode-update-manifest m)
  (unless (update-manifest? m)
    (raise-argument-error 'encode-update-manifest "update-manifest?" m))
  (encode-app-value (manifest->value m)))
(define (decode-update-manifest raw)
  (define v (decode-app-value raw))
  (closed-map! v manifest-keys)
  (unless (equal? (hash-ref v "format") "keel-update-manifest/1")
    (error 'decode-update-manifest "unsupported manifest format"))
  (define artifacts (hash-ref v "artifacts"))
  (unless (list? artifacts)
    (error 'decode-update-manifest "artifacts must be a list"))
  (define m
    (update-manifest (hash-ref v "application_id")
                     (hash-ref v "version")
                     (hash-ref v "build")
                     (hash-ref v "channel")
                     (hash-ref v "published_at")
                     (hash-ref v "minimum_version")
                     (hash-ref v "previous_version")
                     (hash-ref v "rollback_allowed")
                     (hash-ref v "rollout")
                     (map value->artifact artifacts)))
  ;; Reject alternate representations normalized by the record guards.
  (unless (bytes=? raw (encode-update-manifest m))
    (error 'decode-update-manifest "noncanonical manifest payload"))
  m)
